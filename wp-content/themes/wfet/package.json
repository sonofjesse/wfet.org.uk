{
  "name": "SOJ Core 2025 WooCommerce",
  "version": "2.0.0",
  "description": "Modern WordPress theme with auto-discovery ACF blocks",
  "main": "functions.php",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:webpack": "webpack --mode development --watch",
    "dev:blocks": "node scripts/build-block-assets.js --watch",
    "dev:hot": "webpack serve --mode development",
    "build": "npm run docs:build && webpack --mode production && npm run build:blocks",
    "build:blocks": "node scripts/build-block-assets.js",
    "build:dev": "npm run docs:build && webpack --mode development",
    "prebuild": "npm run clean",
    "analyze": "webpack --mode production --analyze",
    "clean": "rm -rf dist/css/* dist/js/*",
    "create-block": "node scripts/create-block.js",
    "docs:build": "node scripts/build-docs.js",
    "docs:serve": "npm run docs:build && python3 -m http.server 8080"
  },
  "author": "Son of Jesse",
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "autoprefixer": "^10.4.17",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^12.0.0",
    "core-js": "^3.36.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cssnano": "^6.0.3",
    "glob": "^10.3.10",
    "marked": "^12.0.0",
    "mini-css-extract-plugin": "^2.8.0",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.0",
    "prismjs": "^1.29.0",
    "sass": "^1.71.0",
    "sass-loader": "^14.1.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@barba/core": "^2.10.3",
    "gsap": "^3.13.0",
    "lenis": "^1.3.9"
  }
}
